@@ -552,6 +552,41 @@
                                 RM_PAGE_SIZE_2M);
 
     //
+    // The 512MB-aligned BAR1 offset leaves a hole at the bottom of the
+    // aperture (console / leftover mailbox). ENABLE only checks BAR1 >= FB,
+    // so offset + FB can still overflow a 64GB BAR1 (seen as
+    // NV_ERR_INVALID_ARGUMENT from dmaAllocMapping, then RmInitAdapter
+    // fails). Clamp the identity map to the remaining VA.
+    //
+    {
+        NvU64 bar1VaLimit = pKernelBus->bar1[gfid].mappableLength;
+        NvU64 available;
+
+        if (bar1VaLimit <= bar1Offset)
+        {
+            NV_PRINTF(LEVEL_ERROR,
+                      "CMPUNLOCK_BAR1P2P: BAR1 offset 0x%llx beyond mappable 0x%llx\n",
+                      bar1Offset, bar1VaLimit);
+            return NV_ERR_INSUFFICIENT_RESOURCES;
+        }
+
+        available = RM_ALIGN_DOWN(bar1VaLimit - bar1Offset, RM_PAGE_SIZE_2M);
+        if (bar1MapSize > available)
+        {
+            NV_PRINTF(LEVEL_ERROR,
+                      "CMPUNLOCK_BAR1P2P: clamping static BAR1 size 0x%llx -> 0x%llx "
+                      "(offset 0x%llx mappable 0x%llx)\n",
+                      bar1MapSize, available, bar1Offset, bar1VaLimit);
+            bar1MapSize = available;
+        }
+
+        if (bar1MapSize == 0)
+        {
+            return NV_ERR_INSUFFICIENT_RESOURCES;
+        }
+    }
+
+    //
     // The static mapping is not backed by an allocated physical FB.
     // Here RM describes the memory for the static mapping.
     //
