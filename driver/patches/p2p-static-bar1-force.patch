+        NvU32 cmpDevId = pGpu->idInfo.PCIDeviceID >> 16;
+
+        //
+        // cmpunlocker P2P: AUTO refuses static BAR1 when BAR1 size == FB size
+        // because it also budgets USERD / doorbell / mailbox. ENABLE only
+        // requires BAR1 >= client-visible FB, which a 64GB BAR1 satisfies.
+        // Do not put RMForceStaticBar1 in NVreg_RegistryDwords — GSP rejects
+        // unknown keys with NV_ERR_INVALID_REGISTRY_KEY and leaves WPR2 up.
+        //
+        if ((cmpDevId == 0x20C2) || (cmpDevId == 0x2082))
+        {
+            KernelBif *pKernelBif = GPU_GET_KERNEL_BIF(pGpu);
+
+            pKernelBus->staticBar1ForceType = NV_REG_STR_RM_FORCE_STATIC_BAR1_ENABLE;
+
+            //
+            // Force BAR1 P2P here, not in _kbifInitRegistryOverrides: KernelBif
+            // is constructed before PCIDeviceID is read, so a devId test there
+            // never matches. Left at MAILBOX, kbusInitBar1 reserves the P2P
+            // mailbox, which pushes the static map to BAR1 offset 512MB where
+            // the client FB no longer fits, and the BAR1 P2P caps checks fail.
+            //
+            if (pKernelBif != NULL)
+                pKernelBif->pcieP2PType = NV_REG_STR_RM_PCIEP2P_TYPE_BAR1;
+            NV_PRINTF(LEVEL_ERROR,
+                      "CMPUNLOCK_BAR1P2P: forcing static BAR1 ENABLE (devId=0x%x)\n",
+                      cmpDevId);
+        }
+        else
+        {
+            pKernelBus->staticBar1ForceType = NV_REG_STR_RM_FORCE_STATIC_BAR1_AUTO;
+        }
     }
 
