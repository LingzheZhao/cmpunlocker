--- a/src/nvidia/src/kernel/gpu/bus/arch/maxwell/kern_bus_gm107.c
+++ b/src/nvidia/src/kernel/gpu/bus/arch/maxwell/kern_bus_gm107.c
@@ -191,6 +191,27 @@
     return NV_OK;
 }
 
+static NvU64
+_kbusCmpDefaultBar0Offset(OBJGPU *pGpu, MemoryManager *pMemoryManager)
+{
+    NvU32 devId = pGpu->idInfo.PCIDeviceID >> 16;
+    NvU64 fbSizeMb = pMemoryManager->Ram.fbAddrSpaceSizeMb;
+    NvU64 nativeFbSizeMb = 0;
+
+    if (devId == 0x20C2)
+        nativeFbSizeMb = 0x2000ULL;
+    else if (devId == 0x2082)
+        nativeFbSizeMb = 0x2800ULL;
+
+    if (nativeFbSizeMb != 0 && fbSizeMb > nativeFbSizeMb)
+        fbSizeMb = nativeFbSizeMb;
+
+    if ((fbSizeMb << 20) < DRF_SIZE(NV_PRAMIN))
+        return 0;
+
+    return (fbSizeMb << 20) - DRF_SIZE(NV_PRAMIN);
+}
+
 /*!
  * @brief program the default BAR0 window based on the mode we are running at.
  */
@@ -219,7 +240,7 @@
     }
     else
     {
-        offsetBar0 = (pMemoryManager->Ram.fbAddrSpaceSizeMb << 20) - DRF_SIZE(NV_PRAMIN);
+        offsetBar0 = _kbusCmpDefaultBar0Offset(pGpu, pMemoryManager);
     }
 
