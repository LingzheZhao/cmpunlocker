+/*
+ * Validate the native GSP FB map before MemoryManager copies it and creates
+ * the heap/PMA objects.  This function is deliberately read-only: publishing
+ * a larger fb_length or repairing a malformed region table here would make
+ * CPU-RM trust geometry which GSP-RM did not actually materialize.
+ */
+static NV_STATUS
+_kgspSec2PostblTimingValidateFbLayout(OBJGPU *pGpu, KernelGsp *pKernelGsp)
+{
+    NvU32 devId = pGpu->idInfo.PCIDeviceID >> 16;
+    NvU64 expectedFbSize =
+        (devId == SEC2_POSTBL_TIMING_CMP_170HX_8GB_PCI_DEVICE_ID)
+            ? 0x0000001000000000ULL
+            : 0x0000000A00000000ULL;
+    NvU64 stockFbSize =
+        (devId == SEC2_POSTBL_TIMING_CMP_170HX_8GB_PCI_DEVICE_ID)
+            ? SEC2_POSTBL_TIMING_STOCK_8GB_FB_BYTES
+            : SEC2_POSTBL_TIMING_STOCK_10GB_FB_BYTES;
+    const GspStaticConfigInfo *pGSCI = &pKernelGsp->gspStaticInfo;
+    const NV2080_CTRL_CMD_FB_GET_FB_REGION_INFO_PARAMS *pParams =
+        &pGSCI->fbRegionInfoParams;
+    GspFwWprMeta *pWprMeta = pKernelGsp->pWprMeta;
+    NvU32 numRegions = pParams->numFBRegions;
+    NvU64 publicBytes = 0;
+    NvU64 reservedRegionBytes = 0;
+    NvU64 metaMagic = 0;
+    NvU64 metaRevision = 0;
+    NvU64 metaFbSize = 0;
+    NvU64 protectedStart = 0;
+    const char *pReason = NULL;
+
+    if (devId != SEC2_POSTBL_TIMING_CMP_170HX_8GB_PCI_DEVICE_ID &&
+        devId != SEC2_POSTBL_TIMING_CMP_170HX_10GB_PCI_DEVICE_ID)
+    {
+        pReason = "unsupported PCI device";
+        goto fail;
+    }
+
+    if (pWprMeta == NULL || pKernelGsp->pWprMetaDescriptor == NULL ||
+        memdescGetSize(pKernelGsp->pWprMetaDescriptor) < sizeof(*pWprMeta))
+    {
+        pReason = "WPR metadata unavailable or truncated";
+        goto fail;
+    }
+
+    metaMagic = pWprMeta->magic;
+    metaRevision = pWprMeta->revision;
+    metaFbSize = pWprMeta->fbSize;
+    protectedStart = pWprMeta->gspFwRsvdStart;
+
+    if (metaMagic != GSP_FW_WPR_META_MAGIC ||
+        metaRevision != GSP_FW_WPR_META_REVISION)
+    {
+        pReason = "WPR metadata magic/revision mismatch";
+        goto fail;
+    }
+
+    if (metaFbSize != expectedFbSize || pGSCI->fb_length != expectedFbSize)
+    {
+        pReason = "native FB size does not match PCI geometry";
+        goto fail;
+    }
+
+    if ((metaFbSize & (SEC2_POSTBL_TIMING_FB_REGION_ALIGNMENT - 1)) != 0 ||
+        (protectedStart & (SEC2_POSTBL_TIMING_FB_REGION_ALIGNMENT - 1)) != 0 ||
+        protectedStart <= stockFbSize ||
+        protectedStart >= metaFbSize)
+    {
+        pReason = "invalid or unaligned protected boundary";
+        goto fail;
+    }
+
+    if ((pWprMeta->gspFwWprStart &
+            (SEC2_POSTBL_TIMING_FB_REGION_ALIGNMENT - 1)) != 0 ||
+        (pWprMeta->nonWprHeapOffset &
+            (SEC2_POSTBL_TIMING_FB_REGION_ALIGNMENT - 1)) != 0 ||
+        (pWprMeta->nonWprHeapSize &
+            (SEC2_POSTBL_TIMING_FB_REGION_ALIGNMENT - 1)) != 0 ||
+        (pWprMeta->gspFwWprEnd &
+            (SEC2_POSTBL_TIMING_FB_REGION_ALIGNMENT - 1)) != 0 ||
+        (pWprMeta->gspFwHeapOffset &
+            (SEC2_POSTBL_TIMING_FB_REGION_ALIGNMENT - 1)) != 0 ||
+        (pWprMeta->gspFwHeapSize &
+            (SEC2_POSTBL_TIMING_FB_REGION_ALIGNMENT - 1)) != 0 ||
+        pWprMeta->nonWprHeapSize == 0 ||
+        protectedStart != pWprMeta->nonWprHeapOffset ||
+        pWprMeta->nonWprHeapOffset >
+            NV_U64_MAX - pWprMeta->nonWprHeapSize ||
+        pWprMeta->nonWprHeapOffset + pWprMeta->nonWprHeapSize !=
+            pWprMeta->gspFwWprStart ||
+        pWprMeta->gspFwWprStart >= pWprMeta->gspFwWprEnd ||
+        pWprMeta->gspFwWprEnd > metaFbSize ||
+        pWprMeta->gspFwHeapSize == 0 ||
+        pWprMeta->gspFwHeapOffset < pWprMeta->gspFwWprStart ||
+        pWprMeta->gspFwHeapOffset >= pWprMeta->gspFwWprEnd ||
+        pWprMeta->gspFwHeapSize >
+            pWprMeta->gspFwWprEnd - pWprMeta->gspFwHeapOffset)
+    {
+        pReason = "invalid or unaligned WPR/heap layout";
+        goto fail;
+    }
+
+    if (expectedFbSize <= SEC2_POSTBL_TIMING_MAX_NATIVE_NONPUBLIC_BYTES ||
+        _kgspSec2PostblTimingValidateFbRegionTable(
+            pParams,
+            pGSCI->fb_length,
+            metaFbSize,
+            protectedStart,
+            expectedFbSize - SEC2_POSTBL_TIMING_MAX_NATIVE_NONPUBLIC_BYTES,
+            &publicBytes,
+            &reservedRegionBytes) != NV_OK)
+    {
+        pReason = "native FB region table failed validation";
+        goto fail;
+    }
+
+    NV_PRINTF(LEVEL_ERROR,
+              "SEC2_DEBUG_FB_LAYOUT: validated fbSize=0x%016llx "
+              "protectedStart=0x%016llx publicBytes=0x%016llx "
+              "capacityFloor=0x%016llx reservedRegionBytes=0x%016llx "
+              "regions=%u status=safe build=%s\n",
+              expectedFbSize, protectedStart, publicBytes,
+              expectedFbSize - SEC2_POSTBL_TIMING_MAX_NATIVE_NONPUBLIC_BYTES,
+              reservedRegionBytes,
+              numRegions, SEC2_POSTBL_TIMING_BUILD_FINGERPRINT);
+    return NV_OK;
+
+fail:
+    NV_PRINTF(LEVEL_ERROR,
+              "SEC2_DEBUG_FB_LAYOUT: rejected reason=%s devId=0x%x "
+              "fb_length=0x%016llx expected=0x%016llx "
+              "metaMagic=0x%016llx metaRevision=%llu metaFbSize=0x%016llx "
+              "protectedStart=0x%016llx regions=%u build=%s\n",
+              pReason, devId, pGSCI->fb_length, expectedFbSize,
+              metaMagic, metaRevision, metaFbSize, protectedStart,
+              numRegions, SEC2_POSTBL_TIMING_BUILD_FINGERPRINT);
+    return NV_ERR_INVALID_STATE;
+}
 
