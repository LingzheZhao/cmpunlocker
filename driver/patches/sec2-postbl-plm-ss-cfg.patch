+/*
+ * Pure, read-only validation of the GSP-provided region table.  Keep GPU
+ * object access and diagnostics in the wrapper below so this logic can be
+ * exercised independently with boundary-value vectors.
+ */
+static NV_STATUS
+_kgspSec2PostblTimingValidateFbRegionTable
+(
+    const NV2080_CTRL_CMD_FB_GET_FB_REGION_INFO_PARAMS *pParams,
+    NvU64 fbLength,
+    NvU64 metaFbSize,
+    NvU64 protectedStart,
+    NvU64 minPublicBytes,
+    NvU64 *pPublicBytes,
+    NvU64 *pReservedRegionBytes
+)
+{
+    NvU32 i;
+    NvU64 expectedBase = 0;
+    NvU64 totalBytes = 0;
+    NvU64 publicBytes = 0;
+    NvU64 reservedRegionBytes = 0;
+
+    if (pParams == NULL || pPublicBytes == NULL ||
+        pReservedRegionBytes == NULL ||
+        fbLength == 0 || fbLength != metaFbSize ||
+        minPublicBytes > metaFbSize ||
+        (metaFbSize & (SEC2_POSTBL_TIMING_FB_REGION_ALIGNMENT - 1)) != 0 ||
+        (protectedStart & (SEC2_POSTBL_TIMING_FB_REGION_ALIGNMENT - 1)) != 0 ||
+        protectedStart == 0 || protectedStart >= metaFbSize ||
+        pParams->numFBRegions == 0 ||
+        pParams->numFBRegions >
+            NV2080_CTRL_CMD_FB_GET_FB_REGION_INFO_MAX_ENTRIES)
+    {
+        return NV_ERR_INVALID_STATE;
+    }
+
+    for (i = 0; i < pParams->numFBRegions; i++)
+    {
+        const NV2080_CTRL_CMD_FB_GET_FB_REGION_FB_REGION_INFO *pRegion =
+            &pParams->fbRegion[i];
+        NvU64 nextBase;
+        NvU64 regionBytes;
+
+        if (pRegion->base != expectedBase || pRegion->limit < pRegion->base ||
+            pRegion->limit == NV_U64_MAX)
+        {
+            return NV_ERR_INVALID_STATE;
+        }
+
+        nextBase = pRegion->limit + 1;
+        if ((pRegion->base &
+                (SEC2_POSTBL_TIMING_FB_REGION_ALIGNMENT - 1)) != 0 ||
+            (nextBase & (SEC2_POSTBL_TIMING_FB_REGION_ALIGNMENT - 1)) != 0 ||
+            nextBase > metaFbSize)
+        {
+            return NV_ERR_INVALID_STATE;
+        }
+
+        regionBytes = nextBase - pRegion->base;
+        if (totalBytes > NV_U64_MAX - regionBytes)
+            return NV_ERR_INVALID_STATE;
+        totalBytes += regionBytes;
+
+        if (pRegion->reserved != 0)
+        {
+            /* FWCLIENT maps any nonzero reservation as a full reserved region. */
+            if (pRegion->reserved != regionBytes ||
+                reservedRegionBytes > NV_U64_MAX - regionBytes)
+            {
+                return NV_ERR_INVALID_STATE;
+            }
+            reservedRegionBytes += regionBytes;
+        }
+        else
+        {
+            if (pRegion->bProtected ||
+                pRegion->regionTag != NV2080_FB_REGION_TAG_NONE ||
+                pRegion->limit >= protectedStart ||
+                publicBytes > NV_U64_MAX - regionBytes)
+            {
+                return NV_ERR_INVALID_STATE;
+            }
+            publicBytes += regionBytes;
+        }
+
+        expectedBase = nextBase;
+    }
+
+    if (expectedBase != metaFbSize || totalBytes != metaFbSize ||
+        publicBytes > totalBytes ||
+        reservedRegionBytes != totalBytes - publicBytes)
+    {
+        return NV_ERR_INVALID_STATE;
+    }
+
+    {
+        const NV2080_CTRL_CMD_FB_GET_FB_REGION_FB_REGION_INFO *pTopRegion =
+            &pParams->fbRegion[pParams->numFBRegions - 1];
+        NvU64 protectedBytes = metaFbSize - protectedStart;
+
+        if (pTopRegion->base != protectedStart ||
+            pTopRegion->limit != metaFbSize - 1 ||
+            pTopRegion->reserved != protectedBytes ||
+            pTopRegion->bProtected ||
+            pTopRegion->regionTag != NV2080_FB_REGION_TAG_GSP_CARVEOUT)
+        {
+            return NV_ERR_INVALID_STATE;
+        }
+    }
+
+    if (publicBytes < minPublicBytes)
+        return NV_ERR_INVALID_STATE;
+
+    *pPublicBytes = publicBytes;
+    *pReservedRegionBytes = reservedRegionBytes;
+    return NV_OK;
+}
