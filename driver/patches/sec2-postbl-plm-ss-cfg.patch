+static NvBool
+_kgspSec2PostblTimingEnabled(OBJGPU *pGpu)
+{
+    NvU32 devId = pGpu->idInfo.PCIDeviceID >> 16;
+    return (devId == SEC2_POSTBL_TIMING_CMP_170HX_8GB_PCI_DEVICE_ID ||
+            devId == SEC2_POSTBL_TIMING_CMP_170HX_10GB_PCI_DEVICE_ID);
