--- a/src/nvidia/src/kernel/platform/p2p/p2p_caps.c
+++ b/src/nvidia/src/kernel/platform/p2p/p2p_caps.c
@@ -669,6 +669,28 @@
         NV_PRINTF(LEVEL_INFO, "Unrecognized CPU. Read Cap is disabled\n");
     }
 
+    //
+    // cmpunlocker P2P: the read cap above is granted only for a common PCIe
+    // switch, Ryzen, or Xeon-SPR. clFindCommonDownstreamBR() often fails to
+    // identify the PLX switches these cards sit behind, so restore the cap for
+    // CMP device IDs. This does not invent a path the silicon lacks; it only
+    // undoes a conservative host whitelist. Re-verify with a real peer copy on
+    // a new topology rather than trusting nvidia-smi advertisement.
+    //
+    {
+        NvU32 cmpDevId = pGpu->idInfo.PCIDeviceID >> 16;
+
+        if (((cmpDevId == 0x20C2) || (cmpDevId == 0x2082)) &&
+            (*pP2PReadCapStatus != NV0000_P2P_CAPS_STATUS_OK))
+        {
+            NV_PRINTF(LEVEL_ERROR,
+                      "CMPUNLOCK_BAR1P2P: forcing read cap OK for CMP devId=0x%x "
+                      "(clFindCommonDownstreamBR did not grant BAR1 P2P reads)\n",
+                      cmpDevId);
+            *pP2PReadCapStatus = NV0000_P2P_CAPS_STATUS_OK;
+        }
+    }
+
     return NV_OK;
 }
 
