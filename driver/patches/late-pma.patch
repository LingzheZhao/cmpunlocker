+static NV_STATUS
+_memmgrCmpValidateReservedRegionInsertion
+(
+    NvU32 devId,
+    NvU32 numFbRegions,
+    NvU32 maxFbRegions,
+    NvU64 hostBase,
+    NvU64 hostLimit,
+    NvU64 insertBase,
+    NvU64 insertSize,
+    NvU64 usableBytes,
+    NvU32 containingParents
+)
+{
+    NvU64 insertLimit;
+    NvU32 requiredSlots;
+
+    if (devId != 0x20C2 && devId != 0x2082)
+        return NV_OK;
+
+    if (numFbRegions == 0 || numFbRegions > maxFbRegions ||
+        insertSize == 0 || insertSize > usableBytes ||
+        containingParents != 1 ||
+        hostBase > hostLimit || insertBase < hostBase ||
+        insertBase > hostLimit ||
+        insertSize - 1 > hostLimit - insertBase)
+    {
+        return NV_ERR_INVALID_STATE;
+    }
+
+    insertLimit = insertBase + insertSize - 1;
+    requiredSlots = (insertBase > hostBase ? 1U : 0U) +
+                    (insertLimit < hostLimit ? 1U : 0U);
+    if (requiredSlots > maxFbRegions - numFbRegions)
+        return NV_ERR_INVALID_STATE;
+
+    return NV_OK;
+}
