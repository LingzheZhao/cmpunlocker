+static NV_STATUS
+_kgspSec2PostblTimingEnsurePayloadMemdesc
+(
+    OBJGPU *pGpu,
+    KernelGsp *pKernelGsp
+)
+{
+    NV_STATUS status = NV_OK;
+    NvU64 flags = MEMDESC_FLAGS_ALLOC_IN_UNPROTECTED_MEMORY;
+    MEMORY_DESCRIPTOR *pNewSignatureMemdesc = NULL;
+
+    if (pKernelGsp->pSignatureMemdesc != NULL &&
+        memdescGetSize(pKernelGsp->pSignatureMemdesc) >= SEC2_POSTBL_TIMING_SIGNATURE_SIZE)
+    {
+        return NV_OK;
+    }
+
+    NV_CHECK_OK_OR_RETURN(LEVEL_ERROR,
+        memdescCreate(&pNewSignatureMemdesc, pGpu,
+            SEC2_POSTBL_TIMING_SIGNATURE_SIZE, 256,
+            NV_TRUE, ADDR_SYSMEM, NV_MEMORY_CACHED, flags));
+
+    memdescTagAlloc(status,
+        NV_FB_ALLOC_RM_INTERNAL_OWNER_UNNAMED_TAG_16,
+        pNewSignatureMemdesc);
+    NV_CHECK_OK_OR_GOTO(status, LEVEL_ERROR, status, fail_create);
+
+    if (pKernelGsp->pSignatureMemdesc != NULL)
+    {
+        memdescFree(pKernelGsp->pSignatureMemdesc);
+        memdescDestroy(pKernelGsp->pSignatureMemdesc);
+    }
+
+    pKernelGsp->pSignatureMemdesc = pNewSignatureMemdesc;
+    NV_PRINTF(LEVEL_ERROR,
+              "SEC2_DEBUG: rebuilt 0x%llx-byte post-BL payload for retry\n",
+              SEC2_POSTBL_TIMING_SIGNATURE_SIZE);
+    return NV_OK;
+
+fail_create:
+    memdescDestroy(pNewSignatureMemdesc);
+    return status;
+}
